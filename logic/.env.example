# Copy to logic/.env to override the defaults for local runs. All values are optional.

# Interface to bind. Default 127.0.0.1 (also opens the browser); use 0.0.0.0 to serve externally.
# HOST=127.0.0.1

# Port to serve on. Default: first free port from 8765. Cloud Run sets this itself.
# PORT=8765

# Base URL of the Ollama server.
# OLLAMA_URL=http://localhost:11434
